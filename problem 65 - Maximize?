#include <iostream>

using namespace std;

void solve() {
    int x;
    cin >> x;
    // The optimal y is always x - 1
    cout << x - 1 << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
