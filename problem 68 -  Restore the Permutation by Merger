#include <iostream>
#include <vector>
#include <unordered_set>

using namespace std;

void solve() {
    int n;
    cin >> n;
    
    unordered_set<int> seen;
    vector<int> original_permutation;
    
    for (int i = 0; i < 2 * n; ++i) {
        int x;
        cin >> x;
        // If we haven't seen this number yet, it's part of the original order
        if (seen.find(x) == seen.end()) {
            seen.insert(x);
            original_permutation.push_back(x);
        }
    }
    
    // Print the restored permutation
    for (int i = 0; i < n; ++i) {
        cout << original_permutation[i] << (i == n - 1 ? "" : " ");
    }
    cout << "\n";
}

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
