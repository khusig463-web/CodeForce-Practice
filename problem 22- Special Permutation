#include <iostream>

using namespace std;

void solve() {
    int n;
    cin >> n;
    
    // Print from 2 to n
    for (int i = 2; i <= n; ++i) {
        cout << i << " ";
    }
    // Print 1 at the end
    cout << 1 << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
