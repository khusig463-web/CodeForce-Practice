#include <vector>
#include <algorithm>

using namespace std;


void solve() {
    int t;
    if (!(cin >> t)) return;
    
    while (t--) {
        int n, f, k;
        cin >> n >> f >> k;
        
        vector<int> a(n);
        for (int i = 0; i < n; ++i) {
            cin >> a[i];
        }
        
        // Find the value of the favorite cube (1-indexed to 0-indexed)
        int fav_val = a[f - 1];
        
        // Sort in descending order
        sort(a.begin(), a.end(), greater<int>());
        
        // Count how many elements are strictly greater and how many are equal
        int greater_count = 0;
        int equal_count = 0;
        for (int x : a) {
            if (x > fav_val) greater_count++;
            else if (x == fav_val) equal_count++;
        }
        
        // Determine the result based on the threshold k
        if (greater_count + equal_count <= k) {
            cout << "YES\n";
        } else if (greater_count >= k) {
            cout << "NO\n";
        } else {
            cout << "MAYBE\n";
        }
    }
}

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    solve();
    
    return 0;
}
