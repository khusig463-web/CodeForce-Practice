#include <iostream>
#include <algorithm>
using namespace std;
 
int main(){
    int n;
    cin>>n;
    
    while(n--){
        int t;
        cin>>t;
        
        int arr[t];
        for(int i=0;i<t;i++){
            cin>>arr[i];
        }
        sort(arr, arr + t);
        
        int sum=0;
        for(int i=0;i<t;i++){
            if(arr[i]<0){
                sum=sum-arr[i];
            }
            else{
                sum+=arr[i];
            }
        }
        cout << sum << endl;
    }
    return 0;
}
