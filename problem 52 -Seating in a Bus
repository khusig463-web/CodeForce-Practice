#include <iostream>
#include <vector>

using namespace std;

void solve() {
    int n;
    cin >> n;
    vector<int> a(n);
    for (int i = 0; i < n; ++i) {
        cin >> a[i];
    }

    // Size n + 2 handles boundary conditions seamlessly without manual if-checks
    vector<bool> occupied(n + 2, false);
    
    // First passenger can sit anywhere
    occupied[a[0]] = true;
    
    bool valid = true;
    for (int i = 1; i < n; ++i) {
        int current_seat = a[i];
        // Check if either neighbor is occupied
        if (!occupied[current_seat - 1] && !occupied[current_seat + 1]) {
            valid = false;
            // We cannot break immediately if we need to finish reading input, 
            // but since we read all input upfront into vector 'a', we can break safely.
            break;
        }
        occupied[current_seat] = true;
    }

    if (valid) {
        cout << "YES\n";
    } else {
        cout << "NO\n";
    }
}

int main() {
    // Optimize standard I/O operations for performance
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
