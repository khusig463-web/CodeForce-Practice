#include <iostream>
using namespace std;
 
int main(){
    int n;
    cin>>n;
    
    while(n--){
        string s;
        cin>>s;
        
        bool p=false;
        for(int i=0;i<s.size()-1;i++){
            if(s[i]==s[i+1]){
                p=true;
            }
        }
        if(p){
            cout << "1"<<endl;
        }
        else{
            cout << s.size() << endl;
        }
    }
    return 0;
}
