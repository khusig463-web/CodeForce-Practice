#include <iostream>
#include <string>
#include <vector>

using namespace std;

void solve() {
    int n, k;
    cin >> n >> k;
    string s;
    cin >> s;

    int operations = 0;
    for (int i = 0; i < n; ) {
        if (s[i] == 'B') {
            operations++;
            i += k; // Skip the next k cells covered by the eraser
        } else {
            i++;    // Move to the next cell
        }
    }
    cout << operations << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
