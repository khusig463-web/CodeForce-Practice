#include <iostream>
using namespace std;
 
int main(){
    int n;
    cin>>n;
    
    while(n--){
        int n1,s,x;
        cin >> n1>>s>>x;
        
        int sum=0;
        for(int i=0;i<n1;i++){
            int a;
            cin>>a;
            sum+=a;
        }
        if(sum<=s && ((s-sum)%x==0)){
            cout << "YES"<<endl;
        }
        else{
            cout <<"NO"<<endl;
        }
    }
}
