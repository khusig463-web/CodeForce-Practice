#include <iostream>
using namespace std;
 
int main(){
    int t;
    cin>>t;
    
    while(t--){
        int n,k;
        cin>>n>>k;
        
        int arr[n];
        int l=0;
        int ans=0;
        bool s=false;
        for(int i=0;i<n;i++){
            cin>>arr[i];
            if(s){
                s=false;
                continue;
            }
            
            if(arr[i]==0){
                l++;
                if(l==k){
                    ans++;
                    s=true;
                }
            }
            else{
                l=0;
            }
        }
        cout << ans << endl;
    }
    return 0;
}
