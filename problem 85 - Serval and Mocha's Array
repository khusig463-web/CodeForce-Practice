#include <iostream>
#include <vector>
#include <numeric> // Required for std::gcd

void solve() {
    int n;
    std::cin >> n;
    std::vector<int> a(n);
    for (int i = 0; i < n; ++i) {
        std::cin >> a[i];
    }

    // Check all possible pairs to see if any pair has a GCD <= 2
    for (int i = 0; i < n; ++i) {
        for (int i = 0; i < n; ++i) {
            for (int j = i + 1; j < n; ++j) {
                if (std::gcd(a[i], a[j]) <= 2) {
                    std::cout << "Yes\n";
                    return;
                }
            }
        }
    }

    std::cout << "No\n";
}

int main() {
    // Fast I/O
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);

    int t;
    std::cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
