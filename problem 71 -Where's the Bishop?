#include <iostream>
#include <vector>
#include <string>

using namespace std;

void solve() {
    vector<string> grid(8);
    for (int i = 0; i < 8; ++i) {
        cin >> grid[i];
    }

    // The bishop is not placed on the edges (row/col 0 and 7 in 0-indexed syntax)
    for (int r = 1; r < 7; ++r) {
        for (int c = 1; c < 7; ++c) {
            // Check if the current cell and all 4 immediate diagonal neighbors are attacked
            if (grid[r][c] == '#' && 
                grid[r-1][c-1] == '#' && grid[r-1][c+1] == '#' &&
                grid[r+1][c-1] == '#' && grid[r+1][c+1] == '#') {
                
                // Codeforces expects 1-based indexing for the output
                cout << r + 1 << " " << c + 1 << "\n";
                return;
            }
        }
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
