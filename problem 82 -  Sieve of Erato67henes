#include <iostream>
#include <map>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        map<int, int> mpp;

        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;
            mpp[x] = 1;
        }

        if (mpp.find(67) != mpp.end()) {
            cout << "YES" << endl;
        }
        else {
            cout << "NO" << endl;
        }
    }

    return 0;
}
