#include <iostream>
using namespace std;
 
int main(){
    string s;
    cin>>s;
    string t;
    cin>>t;
    int c=1;
    int idx=0;
    for(int i=0;i<t.size();i++){
        
        if(idx<s.size() && s[idx]==t[i]){
            c++;
            idx++;
            
        }
        
    }
    cout << c << endl;
    return 0;
    
}
