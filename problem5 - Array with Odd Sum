#include <iostream>
using namespace std;
 
int main(){
    int n;
    cin>>n;
    
    while(n--){
        int n1;
        cin>>n1;
        
        int sum=0;
        int e=0;
        int o=0;
        
        for(int i=0;i<n1;i++){
            int a;
            cin>>a;
            sum+=a;
            
            if(a%2==0){
                e++;
            }
            else{
                o++;
            }
        }
        if(sum%2==1){
            cout << "YES"<<endl;
        }
        else{
            if(e>0 && o>0){
                cout <<"YES"<<endl;
            }
            else{
                cout <<"NO"<<endl;
            }
        }
    }
    return 0;
}
