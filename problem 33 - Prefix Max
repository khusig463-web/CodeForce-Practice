#include <iostream>
using namespace std;
 
int main(){
    int t;
    cin>>t;
    
    while(t--){
        int n;
        cin>>n;
        
        int a=0;
        for(int i=0;i<n;i++){
            int ai;
            cin>>ai;
            a=max(a,ai);
        }
        cout << a*n<<endl;
    }
    return 0;
}
