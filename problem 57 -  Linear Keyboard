#include <iostream>
#include <string>
#include <vector>
#include <cmath>
 
using namespace std;
 
void solve() {
    string keyboard;
    string word;
    cin >> keyboard >> word;
    
    // Store the 0-indexed position of each character
    vector<int> pos(26);
    for (int i = 0; i < 26; ++i) {
        pos[keyboard[i] - 'a'] = i;
    }
    
    int total_time = 0;
    // Calculate the total time by summing absolute differences between consecutive characters
    for (size_t i = 1; i < word.length(); ++i) {
        int prev_pos = pos[word[i - 1] - 'a'];
        int curr_pos = pos[word[i] - 'a'];
        total_time += abs(curr_pos - prev_pos);
    }
    
    cout << total_time << "\n";
}
 
int main() {
    // Optimize standard I/O operations for performance
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
