#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        long long a, b, n;
        cin >> a >> b >> n;

        int cnt = 0;

        while (max(a, b) <= n) {
            if (a < b)
                a += b;
            else
                b += a;

            cnt++;
        }

        cout << cnt << "\n";
    }

    return 0;
}
