#include <iostream>
#include <algorithm>
using namespace std;
 
int main(){
    int t;
    cin>>t;
    
    while(t--){
        int n;
        cin>>n;
        string s;
        cin>>s;
        string ans="";
        for(int i=s.size()-1;i>=0;i--){
            char ch=s[i];
            ans+=s[i];
            i--;
            while(i>=0 && s[i]!=ch){
                i--;
            }
            
        }
        reverse(ans.begin(),ans.end());
        cout << ans << endl;
    }
    return 0;
}
