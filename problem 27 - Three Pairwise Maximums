#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

void solve() {
    vector<int> v(3);
    cin >> v[0] >> v[1] >> v[2];
    
    // Sort the maximums in non-decreasing order
    sort(v.begin(), v.end());
    
    // The two largest values must be equal
    if (v[1] != v[2]) {
        cout << "NO\n";
    } else {
        cout << "YES\n";
        // A valid assignment is always (x, x, z) where x <= y <= z
        cout << v[0] << " " << v[0] << " " << v[2] << "\n";
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
