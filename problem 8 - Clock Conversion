#include <iostream>
#include <string>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        int h = stoi(s.substr(0, 2));
        string m = s.substr(3, 2);

        if (h == 0) {
            cout << "12:" << m << " AM\n";
        }
        else if (h < 12) {
            cout << s << " AM\n";
        }
        else if (h == 12) {
            cout << s << " PM\n";
        }
        else {
            h -= 12;

            if (h < 10)
                cout << "0";

            cout << h << ":" << m << " PM\n";
        }
    }
}
