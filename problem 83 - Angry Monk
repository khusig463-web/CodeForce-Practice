#include <iostream>
#include <vector>
#include <algorithm>
#include <numeric>

using namespace std;

void solve() {
    int n, k;
    cin >> n >> k;
    
    vector<int> a(k);
    int max_val = 0;
    int max_idx = -1;
    
    for (int i = 0; i < k; ++i) {
        cin >> a[i];
        if (a[i] > max_val) {
            max_val = a[i];
            max_idx = i;
        }
    }
    
    long long total_operations = 0;
    
    for (int i = 0; i < k; ++i) {
        // Skip the largest piece because it remains intact as the base
        if (i == max_idx) continue; 
        
        // (a[i] - 1) splits + a[i] merges
        total_operations += (2LL * a[i] - 1);
    }
    
    cout << total_operations << "\n";
}

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
