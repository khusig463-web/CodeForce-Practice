#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, k;
        cin >> n >> k;

        vector<int> a(k);

        int mx = 0;

        for (int i = 0; i < k; i++) {
            cin >> a[i];
            mx = max(mx, a[i]);
        }

        int ans = (k - 1) + (n - mx);

        cout << ans << endl;
    }

    return 0;
}
