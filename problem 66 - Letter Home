#include <iostream>
#include <vector>
#include <algorithm>
#include <cmath>

using namespace std;

void solve() {
    int n, s;
    cin >> n >> s;
    
    vector<int> x(n);
    for (int i = 0; i < n; i++) {
        cin >> x[i];
    }
    
    int min_x = x[0];
    int max_x = x[n - 1];
    
    if (s < min_x) {
        cout << max_x - s << "\n";
    } else if (s > max_x) {
        cout << s - min_x << "\n";
    } else {
        int dist = (max_x - min_x) + min(s - min_x, max_x - s);
        cout << dist << "\n";
    }
}

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
