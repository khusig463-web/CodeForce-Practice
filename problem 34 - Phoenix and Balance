#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    while (n--) {
        int t;
        cin >> t;

        long long a = pow(2, t); // largest coin

        // smallest t/2 - 1 coins
        for (int i = 1; i < t / 2; i++) {
            a += pow(2, i);
        }

        long long b = 0;

        // remaining coins
        for (int i = t / 2; i < t; i++) {
            b += pow(2, i);
        }

        cout << abs(a - b) << endl;
    }

    return 0;
}
