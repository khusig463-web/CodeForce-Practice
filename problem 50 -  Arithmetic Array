#include <iostream>
#include <vector>
#include <numeric>

using namespace std;

void solve() {
    int n;
    cin >> n;
    
    int sum = 0;
    for (int i = 0; i < n; ++i) {
        int val;
        cin >> val;
        sum += val;
    }
    
    if (sum == n) {
        cout << 0 << "\n";
    } else if (sum < n) {
        cout << 1 << "\n";
    } else {
        cout << sum - n << "\n";
    }
}

int main() {
    // Optimize standard I/O operations for performance
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
