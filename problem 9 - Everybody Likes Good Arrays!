#include <iostream>
using namespace std;
 
int main(){
    int n;
    cin>>n;
    
    while(n--){
        int n1;
        cin>>n1;
        int p=-1;
        int arr[n1];
        int ans=0;
        for(int i=0;i<n1;i++){
            
            cin>>arr[i];
            if(p!=-1){
                if(arr[i]%2==p%2){
                    ans++;
                }
            }
            p=arr[i];
        }
        cout << ans << endl;
    }
    return 0;
}
